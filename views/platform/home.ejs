<%- include('../partials/head') %>

<main>
  <!-- Topo -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand/30 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-24 top-16 h-72 w-72 rounded-full bg-accent/25 blur-3xl"></div>
    <div class="relative mx-auto flex max-w-5xl flex-col items-center px-4 pb-14 pt-14 text-center sm:pb-24 sm:pt-24">
      <div class="rounded-full bg-brand-gradient p-1 shadow-xl shadow-brand/30">
        <img src="/img/logo-default.svg" alt="" class="h-20 w-20 rounded-full bg-surface object-cover">
      </div>
      <h1 class="text-gradient mt-6 text-4xl font-extrabold tracking-tight sm:text-6xl"><%= settings.name %></h1>
      <p class="mt-4 max-w-2xl text-base text-slate-600 sm:text-xl">Crie o site de agendamento do seu salão em minutos: suas clientes marcam horário pelo celular, e você controla tudo em um painel.</p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
        <a href="/criar" class="btn-primary px-8 py-3.5 text-base">Criar meu salão</a>
        <a href="#entrar" class="btn-outline px-8 py-3.5 text-base">Já tenho um salão</a>
      </div>
      <p class="mt-4 text-sm text-slate-500">Cada salão tem o seu próprio endereço, painel e dados, totalmente separados.</p>
    </div>
  </section>

  <!-- Recursos -->
  <section class="mx-auto max-w-5xl px-4">
    <h2 class="text-center text-2xl font-extrabold sm:text-3xl">Tudo para o seu salão</h2>
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% [
        ['📅','Agendamento online','Horários livres de verdade, com pausa de almoço, folgas e feriados.'],
        ['✅','Confirmação rápida','Fila de confirmação no painel e aviso pelo WhatsApp com um toque.'],
        ['💰','Sinal e pagamentos','Receba 50% ou à vista (Pix, dinheiro, cartão) e acompanhe o que falta.'],
        ['👥','Clientes ativas','Veja quem voltou, quem está sumida e reative com uma mensagem pronta.'],
        ['📊','Relatórios e entradas','Faturamento por serviço e profissional, com exportação para Excel.'],
        ['🎨','A sua marca','Logo, nome, cores e tema escuro ou claro do jeito do seu salão.'],
      ].forEach(([icon, t, d]) => { %>
        <div class="card flex gap-4 !p-5">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-soft text-2xl"><%= icon %></span>
          <div><p class="font-bold"><%= t %></p><p class="mt-1 text-sm text-slate-500"><%= d %></p></div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Entrar -->
  <section id="entrar" class="mx-auto max-w-5xl scroll-mt-6 px-4 pt-16">
    <div class="card relative overflow-hidden sm:!p-8">
      <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-accent/20 blur-3xl"></div>
      <div class="relative grid gap-6 md:grid-cols-2 md:items-center">
        <div>
          <h2 class="text-2xl font-extrabold sm:text-3xl">Já tem um salão aqui?</h2>
          <p class="mt-2 text-slate-500">Digite o endereço que você escolheu no cadastro para abrir o seu painel.</p>
        </div>
        <form id="entrar-form" class="space-y-3" novalidate>
          <label class="label" for="entrar-slug">Endereço do salão</label>
          <div class="flex items-center gap-2">
            <span class="hidden shrink-0 text-sm text-slate-500 sm:inline" id="host-prefix"></span>
            <input id="entrar-slug" class="field" placeholder="meusalao" autocapitalize="none" autocomplete="off" required>
          </div>
          <p id="entrar-erro" class="hidden text-sm font-medium text-red-600 dark:text-red-400"></p>
          <div class="flex flex-wrap gap-2">
            <button class="btn-primary flex-1" data-go="admin">Abrir meu painel</button>
            <button type="button" class="btn-outline flex-1" data-go="site">Ver o site do salão</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<footer class="mt-16 border-t border-slate-200">
  <div class="mx-auto max-w-5xl px-4 py-6 text-center text-xs text-slate-400">© <%= new Date().getFullYear() %> <%= settings.name %></div>
</footer>

<script>
  (function () {
    document.getElementById('host-prefix').textContent = location.host + '/';
    var form = document.getElementById('entrar-form');
    function go(target) {
      var slug = document.getElementById('entrar-slug').value.trim().toLowerCase().replace(/^\/+|\/+$/g, '');
      var err = document.getElementById('entrar-erro');
      if (!/^[a-z0-9][a-z0-9-]{1,29}$/.test(slug)) { err.textContent = 'Endereço inválido: use letras minúsculas, números e hífen.'; err.classList.remove('hidden'); return; }
      location.href = '/' + slug + (target === 'admin' ? '/admin' : '/');
    }
    form.addEventListener('submit', function (e) { e.preventDefault(); go('admin'); });
    form.querySelector('[data-go="site"]').addEventListener('click', function () { go('site'); });
  })();
</script>
</body>
</html>
