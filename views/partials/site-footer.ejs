<% const lift = typeof waLift !== 'undefined' && waLift; %>
<% const pin = '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>'; %>
<% const clock = '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>'; %>
<% const waIcon = '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.1.1.6-.1 1.2Z"/></svg>'; %>

<footer class="mt-12 border-t border-slate-200 bg-surface <%= lift ? 'pb-24 sm:pb-0' : '' %>">
  <div class="mx-auto grid max-w-5xl gap-6 px-4 py-9 text-sm sm:grid-cols-3">
    <!-- Marca -->
    <div>
      <div class="flex items-center gap-3">
        <img src="<%= settings.logo %>" alt="" class="h-10 w-10 rounded-full bg-surface object-cover ring-2 ring-brand/40">
        <p class="text-base font-extrabold"><%= settings.name %></p>
      </div>
      <% if (settings.tagline) { %><p class="mt-3 text-slate-500"><%= settings.tagline %></p><% } %>
    </div>

    <!-- Contato -->
    <div class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Contato</p>
      <% if (settings.address) { %>
        <a class="group flex items-start gap-3" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(settings.address) %>">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"><%- pin %></span>
          <span class="pt-1.5 text-slate-600 group-hover:text-brand"><%= settings.address %></span>
        </a>
      <% } %>
      <% if (settings.phone) { %>
        <a class="group flex items-center gap-3" target="_blank" rel="noopener" href="<%= waNumber ? 'https://wa.me/' + waNumber : 'tel:' + settings.phone.replace(/[^\d+]/g, '') %>">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-green-100 text-green-600 dark:bg-green-900/40 dark:text-green-400"><%- waIcon %></span>
          <span class="text-slate-600 group-hover:text-brand"><%= fmtPhone(settings.phone) %></span>
        </a>
      <% } %>
    </div>

    <!-- Funcionamento -->
    <div class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Funcionamento</p>
      <div class="flex items-start gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"><%- clock %></span>
        <div class="text-slate-600">
          <p class="font-semibold text-slate-700"><%= daysLabel(settings.openDays) %></p>
          <p><%= settings.openTime %> às <%= settings.closeTime %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-slate-200/70">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 text-xs text-slate-400 <%= lift ? 'pr-20 sm:pr-4' : '' %>">
      <span>© <%= new Date().getFullYear() %> <%= settings.name %></span>
      <a href="/admin" class="py-1 hover:text-brand">Área do salão</a>
    </div>
  </div>
</footer>
<% if (waNumber) { %>
  <a href="https://wa.me/<%= waNumber %>?text=<%= encodeURIComponent('Olá! Gostaria de falar com o ' + settings.name) %>" target="_blank" rel="noopener" aria-label="Falar pelo WhatsApp"
     class="fixed right-4 z-30 flex h-14 w-14 items-center justify-center gap-2 rounded-full bg-green-500 text-sm font-semibold text-white shadow-lg active:scale-95 sm:h-auto sm:w-auto sm:px-4 sm:py-3 sm:hover:bg-green-600 <%= lift ? 'bottom-24 sm:bottom-5' : 'bottom-5' %>">
    <%- waIcon.replace('h-5 w-5', 'h-6 w-6 sm:h-5 sm:w-5') %>
    <span class="hidden sm:inline">WhatsApp</span>
  </a>
<% } %>
</body>
</html>
