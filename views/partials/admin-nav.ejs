<%
  const icons = {
    agenda: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
    relatorios: '<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/>',
    entradas: '<rect x="2.5" y="6" width="19" height="13" rx="2.5"/><path d="M2.5 10h19M16 14.5h2.5"/>',
    clientes: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M17 11a3 3 0 1 0 0-6M21.5 20c0-2.6-1.6-4.6-4-5.4"/>',
    servicos: '<circle cx="6" cy="18" r="3"/><circle cx="18" cy="18" r="3"/><path d="M8 16 20 3M16 16 4 3"/>',
    profissionais: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
    bloqueios: '<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/>',
    config: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>',
    mais: '<circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>',
  };
  const icon = (k, cls = 'h-6 w-6') => `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[k]}</svg>`;
  const items = [['agenda',base + '/admin','Agenda'],['entradas',base + '/admin/entradas','Entradas'],['clientes',base + '/admin/clientes','Clientes'],['relatorios',base + '/admin/relatorios','Relatórios'],['servicos',base + '/admin/servicos','Serviços'],['profissionais',base + '/admin/profissionais','Profissionais'],['bloqueios',base + '/admin/bloqueios','Bloqueios'],['config',base + '/admin/configuracoes','Personalização']];
  const main = items.slice(0, 3); // Agenda, Entradas, Clientes ficam na barra inferior
  const more = items.slice(3);
%>
<style>@media (max-width: 767px){ body { padding-bottom: calc(5rem + env(safe-area-inset-bottom)); } }</style>

<!-- Topo -->
<header class="border-b border-slate-200 bg-surface pt-[env(safe-area-inset-top)]">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-2.5">
    <a href="<%= base %>/admin" class="flex min-w-0 items-center gap-3">
      <img src="<%= asset(settings.logo) %>" alt="" class="h-9 w-9 shrink-0 rounded-full object-cover">
      <span class="truncate font-extrabold"><%= settings.name %></span>
    </a>
    <nav class="hidden items-center gap-1 text-sm font-medium md:flex">
      <% items.forEach(([key, href, label]) => { %>
        <a href="<%= href %>" class="rounded-lg px-3 py-2 <%= section === key ? 'bg-brand-soft text-brand' : 'text-slate-600 hover:bg-slate-100' %>"><%= label %></a>
      <% }) %>
      <a href="<%= base %>/" target="_blank" class="rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100">Ver site ↗</a>
      <%- include('theme-toggle') %>
      <form method="post" action="<%= base %>/admin/logout"><button class="rounded-lg px-3 py-2 text-slate-500 hover:bg-slate-100">Sair</button></form>
    </nav>
    <div class="md:hidden"><%- include('theme-toggle') %></div>
  </div>
</header>

<!-- Barra inferior (celular) -->
<nav class="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-surface pb-[env(safe-area-inset-bottom)] md:hidden" aria-label="Menu principal">
  <ul class="grid grid-cols-4">
    <% main.forEach(([key, href, label]) => { %>
      <li><a href="<%= href %>" class="flex h-16 flex-col items-center justify-center gap-0.5 text-[11px] font-medium <%= section === key ? 'text-brand' : 'text-slate-500' %>"><%- icon(key) %><%= label %></a></li>
    <% }) %>
    <li><button type="button" id="more-btn" aria-expanded="false" aria-controls="more-sheet" class="flex h-16 w-full flex-col items-center justify-center gap-0.5 text-[11px] font-medium <%= more.some(m => m[0] === section) ? 'text-brand' : 'text-slate-500' %>"><%- icon('mais') %>Mais</button></li>
  </ul>
</nav>

<!-- Folha "Mais" -->
<div id="more-sheet" class="fixed inset-0 z-40 hidden md:hidden">
  <div id="more-backdrop" class="absolute inset-0 bg-black/50"></div>
  <div class="absolute inset-x-0 bottom-0 rounded-t-3xl bg-surface p-4 pb-[calc(1rem+env(safe-area-inset-bottom))] shadow-2xl">
    <div class="mx-auto mb-3 h-1.5 w-10 rounded-full bg-slate-300"></div>
    <ul class="space-y-1">
      <% more.forEach(([key, href, label]) => { %>
        <li><a href="<%= href %>" class="flex min-h-[48px] items-center gap-3 rounded-xl px-3 font-medium <%= section === key ? 'bg-brand-soft text-brand' : 'text-slate-700' %>"><%- icon(key, 'h-5 w-5') %><%= label %></a></li>
      <% }) %>
      <li><a href="<%= base %>/" target="_blank" class="flex min-h-[48px] items-center gap-3 rounded-xl px-3 font-medium text-slate-700">↗ Ver site</a></li>
      <li><form method="post" action="<%= base %>/admin/logout"><button class="flex min-h-[48px] w-full items-center gap-3 rounded-xl px-3 font-medium text-slate-500">Sair</button></form></li>
    </ul>
  </div>
</div>
<script>
  (function () {
    var sheet = document.getElementById('more-sheet'), btn = document.getElementById('more-btn');
    function toggle(open) { sheet.classList.toggle('hidden', !open); btn.setAttribute('aria-expanded', open); document.body.style.overflow = open ? 'hidden' : ''; }
    btn.addEventListener('click', function () { toggle(true); });
    document.getElementById('more-backdrop').addEventListener('click', function () { toggle(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') toggle(false); });
  })();
</script>
