<header class="sticky top-0 z-30 border-b border-slate-200/60 bg-surface/70 pt-[env(safe-area-inset-top)] backdrop-blur-xl">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-2.5">
    <a href="<%= base %>/" class="flex min-w-0 items-center gap-3">
      <img src="<%= asset(settings.logo) %>" alt="Logo <%= settings.name %>" class="h-10 w-10 shrink-0 rounded-full bg-surface object-cover ring-2 ring-brand/40">
      <span class="truncate text-lg font-extrabold tracking-tight"><%= settings.name %></span>
    </a>

    <!-- Computador -->
    <nav class="hidden items-center gap-1 text-sm font-medium sm:flex" aria-label="Menu">
      <a href="<%= base %>/#servicos" class="rounded-xl px-3 py-2 text-slate-600 hover:bg-slate-100">Serviços</a>
      <a href="<%= base %>/#equipe" class="rounded-xl px-3 py-2 text-slate-600 hover:bg-slate-100">Equipe</a>
      <%- include('theme-toggle') %>
      <a href="<%= base %>/agendar" class="btn-primary ml-1">Agendar</a>
    </nav>

    <!-- Celular -->
    <div class="flex items-center gap-1 sm:hidden">
      <%- include('theme-toggle') %>
      <button type="button" id="menu-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-sheet"
        class="flex h-11 w-11 items-center justify-center rounded-xl text-slate-700 hover:bg-slate-100">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Menu do celular -->
<div id="menu-sheet" class="fixed inset-0 z-40 hidden sm:hidden">
  <div id="menu-backdrop" class="absolute inset-0 bg-black/50"></div>
  <div class="absolute inset-x-0 top-0 rounded-b-3xl bg-surface p-4 pb-5 pt-[calc(1rem+env(safe-area-inset-top))] shadow-2xl">
    <div class="mb-2 flex items-center justify-between">
      <span class="font-extrabold"><%= settings.name %></span>
      <button type="button" id="menu-close" aria-label="Fechar menu" class="flex h-11 w-11 items-center justify-center rounded-xl text-slate-600 hover:bg-slate-100">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <ul class="space-y-1 text-base font-medium">
      <li><a href="<%= base %>/" class="flex min-h-[48px] items-center rounded-xl px-3 hover:bg-slate-100">Início</a></li>
      <li><a href="<%= base %>/#servicos" class="flex min-h-[48px] items-center rounded-xl px-3 hover:bg-slate-100">Serviços</a></li>
      <li><a href="<%= base %>/#equipe" class="flex min-h-[48px] items-center rounded-xl px-3 hover:bg-slate-100">Equipe</a></li>
      <% if (settings.phone) { %><li><a href="tel:<%= settings.phone.replace(/[^\d+]/g, '') %>" class="flex min-h-[48px] items-center rounded-xl px-3 hover:bg-slate-100">Ligar: <%= fmtPhone(settings.phone) %></a></li><% } %>
      <% if (waNumber) { %><li><a href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener" class="flex min-h-[48px] items-center rounded-xl px-3 hover:bg-slate-100">WhatsApp</a></li><% } %>
      <li><a href="<%= base %>/admin" class="flex min-h-[48px] items-center rounded-xl px-3 text-slate-500 hover:bg-slate-100">Área do salão</a></li>
    </ul>
    <a href="<%= base %>/agendar" class="btn-primary mt-3 w-full py-3.5 text-base">Agendar horário</a>
  </div>
</div>
<script>
  (function () {
    var sheet = document.getElementById('menu-sheet'), btn = document.getElementById('menu-btn');
    function toggle(open) {
      sheet.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }
    btn.addEventListener('click', function () { toggle(true); });
    document.getElementById('menu-close').addEventListener('click', function () { toggle(false); });
    document.getElementById('menu-backdrop').addEventListener('click', function () { toggle(false); });
    sheet.addEventListener('click', function (e) { if (e.target.closest('a')) toggle(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') toggle(false); });
  })();
</script>
