<%- include('../partials/head') %>
<main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center px-4">
  <div class="mb-6 text-center">
    <div class="mx-auto mb-3 w-fit rounded-full bg-brand-gradient p-1 shadow-xl shadow-brand/30"><img src="<%= settings.logo %>" alt="" class="h-16 w-16 rounded-full bg-surface object-cover"></div>
    <h1 class="text-gradient text-2xl font-extrabold">Nova senha</h1>
    <p class="text-sm text-slate-500"><%= settings.name %></p>
  </div>

  <% if (!valid) { %>
    <div class="card space-y-3 text-center">
      <h2 class="text-lg font-extrabold">Link inválido ou expirado</h2>
      <p class="text-sm text-slate-500">Este link já foi usado ou passou de 30 minutos. Peça um novo link.</p>
      <a href="/admin/recuperar" class="btn-primary w-full">Pedir novo link</a>
    </div>
  <% } else { %>
    <form method="post" class="card space-y-4">
      <% if (error) { %><p class="rounded-xl bg-red-100 px-3 py-2 text-sm font-medium text-red-700 dark:bg-red-900/40 dark:text-red-300" role="alert"><%= error %></p><% } %>
      <div>
        <label class="label" for="password">Nova senha</label>
        <input id="password" name="password" type="password" class="field" required minlength="6" autofocus autocomplete="new-password">
      </div>
      <div>
        <label class="label" for="password2">Repita a nova senha</label>
        <input id="password2" name="password2" type="password" class="field" required minlength="6" autocomplete="new-password">
      </div>
      <p class="-mt-2 text-xs text-slate-500">Mínimo de 6 caracteres.</p>
      <button class="btn-primary w-full">Salvar nova senha</button>
    </form>
  <% } %>
</main>
</body>
</html>
