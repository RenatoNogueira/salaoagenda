<%
  const badge = {
    pendente: 'bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300',
    confirmado: 'bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300',
    concluido: 'bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300',
    cancelado: 'bg-slate-200 text-slate-500',
  };
  const edge = { pendente: 'bg-amber-400', confirmado: 'bg-blue-500', concluido: 'bg-green-500', cancelado: 'bg-slate-400' };
  const label = { pendente: 'Pendente', confirmado: 'Confirmado', concluido: 'Concluído', cancelado: 'Cancelado' };
  const digits = a.clientPhone.replace(/\D/g, '');
  const wa = digits.startsWith('55') ? digits : '55' + digits;
  const msg = `Olá, ${a.clientName}! Seu horário no ${settings.name} (${a.service ? a.service.name : 'serviço'}) ${a.status === 'confirmado' ? 'está confirmado' : 'foi recebido'} para ${dateBR(a.date)} às ${a.time}. Até lá!`;
%>
<article class="card relative overflow-hidden space-y-3 !p-4 pl-5 <%= a.status === 'cancelado' ? 'opacity-60' : '' %>"
         data-card data-id="<%= a.id %>" data-status="<%= a.status %>" data-upcoming="<%= a.date >= today ? 1 : 0 %>">
  <span class="absolute inset-y-0 left-0 w-1.5 <%= edge[a.status] %>"></span>
  <div class="flex items-start gap-4">
    <div class="shrink-0 text-center">
      <p class="text-2xl font-extrabold text-brand"><%= a.time %></p>
      <p class="text-xs text-slate-400"><%= a.duration %> min</p>
    </div>
    <div class="min-w-0 flex-1">
      <p class="flex flex-wrap items-center gap-2 font-semibold"><%= a.clientName %>
        <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= badge[a.status] %>"><%= label[a.status] %></span>
      </p>
      <p class="text-sm text-slate-500">
        <%= a.service ? a.service.name : 'Serviço removido' %> · <%= a.professional ? a.professional.name : '—' %>
        <% if (showDate) { %> · <strong><%= dateBR(a.date).slice(0, 5) %></strong><% } %>
      </p>
      <a class="inline-block py-1 text-sm text-brand" href="tel:<%= digits %>"><%= a.clientPhone %></a>
      <% if (a.notes) { %><p class="text-xs italic text-slate-400"><%= a.notes %></p><% } %>
    </div>
  </div>

  <%
    const p = a.pay;
    const money = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    const payBadge = {
      nenhum: ['Não pago', 'bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-300'],
      parcial: ['Pago em parte', 'bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300'],
      sinal: ['Sinal pago', 'bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300'],
      pago: ['Pago ✓', 'bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300'],
    }[p.state];
    const pct = p.total ? Math.min(100, Math.round((p.paid / p.total) * 100)) : 0;
    const showPay = a.status !== 'cancelado' || p.paid > 0;
  %>
  <% if (showPay) { %>
  <div class="space-y-2 rounded-xl bg-slate-50 p-3 ring-1 ring-slate-200/80">
    <div class="flex items-center justify-between gap-2 text-sm">
      <span class="font-semibold">Pagamento</span>
      <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= payBadge[1] %>"><%= payBadge[0] %></span>
    </div>
    <div class="h-2 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-green-500 transition-all" style="width: <%= pct %>%"></div></div>
    <p class="text-xs text-slate-500">
      Recebido <strong class="text-slate-700"><%= money(p.paid) %></strong> de <%= money(p.total) %>
      <% if (p.remaining > 0) { %> · falta <strong class="text-slate-700"><%= money(p.remaining) %></strong><% } %>
    </p>
    <form method="post" action="<%= base %>/admin/agendamentos/<%= a.id %>/pagamento" data-pay-form data-show-date="<%= showDate ? 1 : 0 %>" class="grid grid-cols-2 gap-2">
      <% if (a.status !== 'cancelado' && p.remaining > 0) { %>
        <select name="forma" aria-label="Forma de pagamento" class="field col-span-2 !min-h-[40px] !py-1 text-sm">
          <option value="pix">Pix</option><option value="dinheiro">Dinheiro</option><option value="cartao">Cartão</option>
        </select>
        <% if (p.paid === 0) { %>
          <button name="acao" value="sinal" class="btn-outline btn-sm">Receber <%= settings.depositPercent %>% · <%= money(p.deposit) %></button>
          <button name="acao" value="total" class="btn-primary btn-sm">À vista · <%= money(p.total) %></button>
        <% } else { %>
          <% if (p.depositLeft > 0) { %><button name="acao" value="sinal" class="btn-outline btn-sm">Completar sinal · <%= money(p.depositLeft) %></button><% } %>
          <button name="acao" value="restante" class="btn-primary btn-sm <%= p.depositLeft > 0 ? '' : 'col-span-2' %>">Receber restante · <%= money(p.remaining) %></button>
        <% } %>
      <% } %>
      <% if (p.paid > 0) { %><button name="acao" value="estornar" class="btn-ghost btn-sm col-span-2 text-slate-500" data-title="Desfazer pagamento?" data-confirm="O último valor lançado para <%= a.clientName %> será removido do recebido." data-ok="Sim, desfazer" data-tone="danger">Desfazer último pagamento</button><% } %>
    </form>
  </div>
  <% } %>

  <form method="post" action="<%= base %>/admin/agendamentos/<%= a.id %>/status" data-status-form data-show-date="<%= showDate ? 1 : 0 %>" class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:justify-end">
    <% if (a.status === 'pendente' || a.status === 'confirmado') { %>
      <a class="btn btn-sm col-span-2 border border-green-600/40 text-green-700 dark:text-green-300" target="_blank" rel="noopener" href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent(msg) %>">Avisar no WhatsApp</a>
    <% } %>
    <% if (a.status === 'pendente') { %><button name="status" value="confirmado" class="btn-primary btn-sm" data-title="Confirmar agendamento?" data-confirm="Confirmar o horário de <%= a.clientName %> em <%= dateBR(a.date).slice(0, 5) %> às <%= a.time %>?" data-ok="Sim, confirmar" data-tone="primary">✓ Confirmar</button><% } %>
    <% if (a.status === 'confirmado') { %><button name="status" value="concluido" class="btn-primary btn-sm" data-title="Concluir atendimento?" data-confirm="<%= p.remaining > 0 ? 'Ainda falta receber ' + money(p.remaining) + ' de ' + a.clientName + '. Concluir mesmo assim?' : 'Marcar o atendimento de ' + a.clientName + ' (' + a.time + ') como concluído?' %>" data-ok="Sim, concluir" data-tone="<%= p.remaining > 0 ? 'danger' : 'primary' %>">Concluir</button><% } %>
    <% if (a.status !== 'cancelado' && a.status !== 'concluido') { %><button name="status" value="cancelado" class="btn-outline btn-sm" data-title="Cancelar agendamento?" data-confirm="O horário de <%= a.clientName %> (<%= dateBR(a.date).slice(0, 5) %> às <%= a.time %>) será cancelado e liberado para outras clientes." data-ok="Sim, cancelar" data-tone="danger">Cancelar</button><% } %>
    <% if (a.status === 'confirmado') { %><button name="status" value="pendente" class="btn-ghost btn-sm col-span-2">Voltar para pendente</button><% } %>
    <% if (a.status === 'cancelado') { %><button name="status" value="pendente" class="btn-ghost btn-sm col-span-2">Reabrir</button><% } %>
  </form>
</article>
